@page
@model IndexModel
@{
    ViewData["Title"] = "CQRS Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Tong quan he thong</h2>
        <p class="text-muted mb-0">Du lieu duoc doc tu Analytics Read Model.</p>
    </div>
    <a asp-page="/Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-clockwise me-1"></i>Lam moi
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
    </div>
}
else if (Model.Summary is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75">Tong doanh thu</h6>
                    <h3 class="display-6 fw-bold">@Model.Summary.TotalRevenue.ToString("N0") <small class="fs-6">VNĐ</small></h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75">Tong so don</h6>
                    <h3 class="display-6 fw-bold">@Model.Summary.TotalOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75">Don thanh cong</h6>
                    <h3 class="display-6 fw-bold">@Model.Summary.CompletedOrders</h3>
                    <div class="progress mt-2" style="height: 5px;">
                        <div class="progress-bar bg-white" style="width: @(Model.Summary.SuccessRate)%"></div>
                    </div>
                    <small class="opacity-75">Ty le thanh cong: @Model.Summary.SuccessRate%</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-uppercase opacity-75">Don huy/rollback</h6>
                    <h3 class="display-6 fw-bold">@Model.Summary.CancelledOrders</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted">Khach hang</h6>
                    <h4 class="mb-0">@Model.Summary.TotalCustomers</h4>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted">Gia tri don trung binh</h6>
                    <h4 class="mb-0">@Model.Summary.AverageOrderValue.ToString("N0") VNĐ</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="bi bi-trophy text-warning me-2"></i>Top 5 khach hang chi tieu cao nhat</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Hang</th>
                            <th class="text-start">Khach hang</th>
                            <th>So don</th>
                            <th class="text-end pe-4">Tong chi tieu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopSpenders.Any())
                        {
                            var rank = 1;
                            foreach (var spender in Model.TopSpenders)
                            {
                                <tr>
                                    <td><span class="badge bg-dark rounded-circle p-2">@rank</span></td>
                                    <td class="text-start fw-semibold">
                                        <i class="bi bi-person-circle text-secondary me-2"></i>@spender.CustomerId
                                    </td>
                                    <td>@spender.TotalOrders</td>
                                    <td class="text-end pe-4 fw-bold text-success">@spender.TotalSpent.ToString("N0") VNĐ</td>
                                </tr>
                                rank++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-muted py-4">Chua co du lieu giao dich nao.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Dang tai du lieu tu Read Model...</p>
    </div>
}
