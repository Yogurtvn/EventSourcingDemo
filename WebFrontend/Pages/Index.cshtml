@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard CQRS";
}

<section class="hero-panel mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-4">
        <div>
            <p class="hero-eyebrow">Dashboard CQRS</p>
            <h1>Tổng quan hệ thống</h1>
            <p class="hero-copy">
                Dữ liệu trên màn hình này được đọc từ <strong>Read Model</strong> của AnalyticsService,
                phản ánh kết quả đã được tổng hợp sau khi các event đi qua RabbitMQ.
            </p>
        </div>
        <div class="hero-actions">
            <a asp-page="/Index" class="btn btn-soft-light">
                <i class="bi bi-arrow-clockwise me-2"></i>Làm mới
            </a>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
    </div>
}
else if (Model.Summary is not null)
{
    <section class="stat-grid mb-4">
        <article class="stat-card is-brand">
            <div class="stat-label">
                <span>Tổng doanh thu</span>
                <i class="bi bi-cash-coin"></i>
            </div>
            <h2 class="stat-value">@Model.Summary.TotalRevenue.ToString("N0") <small class="fs-6">VNĐ</small></h2>
            <div class="stat-meta">Giá trị đơn trung bình: @Model.Summary.AverageOrderValue.ToString("N0") VNĐ</div>
        </article>
        <article class="stat-card is-sky">
            <div class="stat-label">
                <span>Tổng đơn hàng</span>
                <i class="bi bi-box-seam"></i>
            </div>
            <h2 class="stat-value">@Model.Summary.TotalOrders</h2>
            <div class="stat-meta">Khách hàng hoạt động: @Model.Summary.TotalCustomers</div>
        </article>
        <article class="stat-card is-success">
            <div class="stat-label">
                <span>Đơn thành công</span>
                <i class="bi bi-check2-circle"></i>
            </div>
            <h2 class="stat-value">@Model.Summary.CompletedOrders</h2>
            <div class="stat-meta">Tỷ lệ thành công: @Model.Summary.SuccessRate%</div>
        </article>
        <article class="stat-card is-danger">
            <div class="stat-label">
                <span>Đơn huỷ / rollback</span>
                <i class="bi bi-arrow-counterclockwise"></i>
            </div>
            <h2 class="stat-value">@Model.Summary.CancelledOrders</h2>
            <div class="stat-meta">Đơn đang chờ xử lý: @Model.Summary.PendingOrders</div>
        </article>
    </section>

    <section class="section-card">
        <div class="section-header">
            <div>
                <p class="section-eyebrow">Top Spenders</p>
                <h2 class="section-title">Khách hàng chi tiêu cao nhất</h2>
                <p class="section-copy">Danh sách này lấy từ AnalyticsService và được làm giàu thêm tên khách hàng từ OrderService.</p>
            </div>
            <div class="metric-chip-row">
                <span class="metric-chip"><i class="bi bi-people"></i>@Model.Summary.TotalCustomers khách hàng</span>
                <span class="metric-chip"><i class="bi bi-graph-up-arrow"></i>@Model.Summary.TotalOrders đơn đã ghi nhận</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Hạng</th>
                        <th>Khách hàng</th>
                        <th>Số đơn</th>
                        <th class="text-end">Tổng chi tiêu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TopSpenders.Any())
                    {
                        var rank = 1;
                        foreach (var spender in Model.TopSpenders)
                        {
                            <tr>
                                <td><span class="rank-badge">@rank</span></td>
                                <td>
                                    <div class="customer-block">
                                        <span class="customer-name">@spender.DisplayCustomerName</span>
                                        @if (!string.Equals(spender.DisplayCustomerName, spender.CustomerId, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="customer-meta">@spender.CustomerId</span>
                                        }
                                    </div>
                                </td>
                                <td>@spender.TotalOrders</td>
                                <td class="text-end fw-semibold">@spender.TotalSpent.ToString("N0") VNĐ</td>
                            </tr>
                            rank++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-state">
                                    <i class="bi bi-bar-chart"></i>
                                    <div>Chưa có dữ liệu giao dịch để hiển thị.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else
{
    <div class="section-card">
        <div class="empty-state">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <div>Đang tải dữ liệu từ Analytics Read Model...</div>
        </div>
    </div>
}
