@{
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Saga Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a asp-page="/Index" class="brand-link text-decoration-none">
                <span class="brand-mark">
                    <i class="bi bi-cpu"></i>
                </span>
                <span>
                    <span class="brand-eyebrow">Event Sourcing Demo</span>
                    <span class="brand-title">Saga Admin</span>
                </span>
            </a>

            <div class="sidebar-card">
                <p class="sidebar-kicker">Bảng điều khiển demo</p>
                <p class="sidebar-copy">
                    Theo dõi luồng Saga, CQRS và Event Sourcing từ một giao diện duy nhất.
                </p>
                <div class="sidebar-tags">
                    <span>RabbitMQ</span>
                    <span>Read Model</span>
                    <span>Timeline</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a asp-page="/Index" class="sidebar-nav-link @(currentPage == "/Index" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard CQRS</span>
                </a>
                <a asp-page="/OrderSimulator" class="sidebar-nav-link @(currentPage == "/OrderSimulator" ? "active" : "")">
                    <i class="bi bi-cart-plus"></i>
                    <span>Tạo đơn hàng</span>
                </a>
                <a asp-page="/OrderList" class="sidebar-nav-link @(currentPage == "/OrderList" ? "active" : "")">
                    <i class="bi bi-list-check"></i>
                    <span>Quản lý đơn hàng</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-chip">
                    <span class="user-avatar">AD</span>
                    <div>
                        <div class="user-name">Admin User</div>
                        <div class="user-role">Demo Operator</div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="app-main">
            <div class="page-shell">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
