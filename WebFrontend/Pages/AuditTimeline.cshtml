@page
@model WebFrontend.Pages.AuditTimelineModel
@{
    ViewData["Title"] = "Audit Timeline";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-clock-history text-primary me-2"></i>Audit Log / Event Timeline</h2>
        <p class="text-muted mb-0">Tong hop dau vet cua Order, Inventory va Payment cho don hang @Model.OrderId</p>
    </div>
    <a asp-page="/OrderList" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lai danh sach
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
    </div>
}
else
{
    <div class="d-grid gap-3">
        @if (Model.TimelineItems.Count == 0)
        {
            <div class="alert alert-warning mb-0">Khong tim thay event nao cho don hang nay.</div>
        }
        else
        {
            foreach (var item in Model.TimelineItems)
            {
                <div class="card shadow-sm border-start border-4 @AuditTimelineModel.GetBorderClass(item.EventType)">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge @AuditTimelineModel.GetBadgeClass(item.Source)">@item.Source</span>
                                    <strong>@item.EventType</strong>
                                    <span class="text-muted">v@item.Version</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Details))
                                {
                                    <div class="text-muted">@item.Details</div>
                                }
                            </div>
                            <div class="text-nowrap text-muted small">
                                @item.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}
