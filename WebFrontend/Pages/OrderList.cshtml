@page
@model WebFrontend.Pages.OrderListModel
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<section class="hero-panel mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-4">
        <div>
            <p class="hero-eyebrow">Order Management</p>
            <h1>Quản lý đơn hàng</h1>
            <p class="hero-copy">
                Danh sách này đọc trực tiếp từ Order Read Model để bạn kiểm tra trạng thái cuối cùng của từng đơn và mở timeline chi tiết.
            </p>
        </div>
        <div class="hero-actions">
            <a asp-page="/OrderList" class="btn btn-soft-light">
                <i class="bi bi-arrow-clockwise me-2"></i>Làm mới
            </a>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
    </div>
}
else
{
    <section class="section-card">
        <div class="section-header">
            <div>
                <p class="section-eyebrow">Read Model</p>
                <h2 class="section-title">Danh sách đơn hàng gần đây</h2>
                <p class="section-copy">Mỗi dòng đại diện cho một aggregate đã được project sang trạng thái đọc hiện tại.</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th class="text-end">Số tiền</th>
                        <th>Trạng thái</th>
                        <th>Cập nhật cuối</th>
                        <th class="text-end">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <div>Chưa có đơn hàng nào để hiển thị.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td class="fw-semibold">@order.OrderId</td>
                                <td>
                                    <div class="customer-block">
                                        <span class="customer-name">@order.DisplayCustomerName</span>
                                        @if (!string.Equals(order.DisplayCustomerName, order.CustomerId, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="customer-meta">@order.CustomerId</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") VNĐ</td>
                                <td>
                                    <span class="status-pill @OrderListModel.GetStatusClass(order.Status)">
                                        @OrderListModel.GetDisplayStatus(order.Status)
                                    </span>
                                </td>
                                <td>@order.LastUpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="text-end">
                                    <a asp-page="/AuditTimeline" asp-route-orderId="@order.OrderId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-clock-history me-1"></i>Xem timeline
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}
